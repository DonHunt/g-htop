pkgname=g_htop
pkgver=0.1.0
pkgrel=2
pkgdesc='Read-only GTK process, service, CPU, network and AMD GPU monitor'
arch=('x86_64')
license=('Apache-2.0')
depends=('gtkmm3' 'glibc' 'gcc-libs' 'systemd' 'iproute2' 'coreutils' 'hicolor-icon-theme')
makedepends=('cmake' 'pkgconf')
optdepends=('pciutils: descriptive AMD GPU names')
options=('!debug')
source=("G_htop-${pkgver}.tar.gz")
sha256sums=('355a8f47e5b6e7231124411a0e79a3bd20118f7b03946eb0e144c8d505c4bd24')

build() {
    cmake -S "$srcdir/G_htop-$pkgver" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build "$srcdir/build" --parallel 2
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
