pkgname=g_htop
pkgver=1.1.0
pkgrel=1
pkgdesc='Read-only GTK process, service, CPU, network and GPU monitor'
arch=('x86_64')
url='https://github.com/DonHunt/g-htop'
license=('Apache-2.0')
depends=('gtkmm3' 'glibc' 'gcc-libs' 'systemd' 'iproute2' 'coreutils' 'hicolor-icon-theme')
makedepends=('cmake' 'pkgconf')
optdepends=('hwdata: descriptive GPU names from PCI identities')
options=('!debug' '!lto')
source=("G_htop-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cmake -S "$srcdir/G_htop-$pkgver" -B "$srcdir/build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib
    cmake --build "$srcdir/build" --parallel 2
}

check() {
    ctest --test-dir "$srcdir/build" --output-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install "$srcdir/build"
}
