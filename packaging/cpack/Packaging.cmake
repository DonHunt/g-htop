# Optional native release metadata; normal application/Arch builds are unchanged.
set(G_HTOP_PACKAGE_FORMAT "" CACHE STRING "Native package format: empty, DEB or RPM")
set_property(CACHE G_HTOP_PACKAGE_FORMAT PROPERTY STRINGS "" DEB RPM)
set(G_HTOP_MAINTAINER_EMAIL "g_htop@don-hunt.com" CACHE STRING "Package maintainer email (owner-approved default)")
if(NOT G_HTOP_PACKAGE_FORMAT)
  return()
endif()
if(NOT G_HTOP_PACKAGE_FORMAT STREQUAL "DEB" AND NOT G_HTOP_PACKAGE_FORMAT STREQUAL "RPM")
  message(FATAL_ERROR "Unsupported package format: ${G_HTOP_PACKAGE_FORMAT}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/HostFamily.cmake")
g_htop_host_family(build_id build_family)
set(CPACK_G_HTOP_BUILD_ID "${build_id}")
set(CPACK_G_HTOP_BUILD_FAMILY "${build_family}")
set(CPACK_G_HTOP_CONFIGURED_FORMAT "${G_HTOP_PACKAGE_FORMAT}")
if(G_HTOP_PACKAGE_FORMAT STREQUAL "DEB")
  set(CMAKE_INSTALL_DOCDIR "${CMAKE_INSTALL_DATAROOTDIR}/doc/g-htop")
else()
  set(CMAKE_INSTALL_DOCDIR "${CMAKE_INSTALL_DATAROOTDIR}/doc/g_htop")
endif()
set(CPACK_GENERATOR "${G_HTOP_PACKAGE_FORMAT}")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_PACKAGE_NAME "g_htop")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_VENDOR "Donald E. Hunt")
set(CPACK_G_HTOP_COPYRIGHT "Copyright © 2026 Donald E. Hunt")
set(CPACK_G_HTOP_LICENSE "Apache-2.0")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "G_htop Community - read-only Linux system monitor")
set(CPACK_PACKAGE_DESCRIPTION "GTK process, service, CPU, network and AMD GPU monitoring dashboard.")
set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")

set(CPACK_G_HTOP_MAINTAINER_EMAIL "${G_HTOP_MAINTAINER_EMAIL}")
set(CPACK_PACKAGE_CONTACT "Donald E. Hunt")
if(G_HTOP_MAINTAINER_EMAIL)
  set(CPACK_PACKAGE_CONTACT "Donald E. Hunt <${G_HTOP_MAINTAINER_EMAIL}>")
endif()

set(CPACK_PROJECT_CONFIG_FILE "${PROJECT_SOURCE_DIR}/packaging/cpack/NativeGate.cmake")

if(G_HTOP_PACKAGE_FORMAT STREQUAL "DEB")
    set(CPACK_DEBIAN_PACKAGE_NAME "g-htop")
    set(CPACK_DEBIAN_PACKAGE_RELEASE "1")
    set(CPACK_DEBIAN_FILE_NAME "DEB-DEFAULT")
    set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
    set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
    set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
    set(CPACK_DEBIAN_PACKAGE_DEPENDS "systemd, iproute2, coreutils, hicolor-icon-theme")
    set(CPACK_DEBIAN_PACKAGE_SUGGESTS "pciutils")
    set(CPACK_DEBIAN_PACKAGE_MAINTAINER "${CPACK_PACKAGE_CONTACT}")
    set(CPACK_DEBIAN_COMPRESSION_TYPE "xz")

    install(FILES "${PROJECT_SOURCE_DIR}/packaging/deb/copyright" DESTINATION "${CMAKE_INSTALL_DOCDIR}")
endif()

if(G_HTOP_PACKAGE_FORMAT STREQUAL "RPM")
    set(CPACK_RPM_PACKAGE_NAME "g_htop")
    set(CPACK_RPM_PACKAGE_RELEASE "1")
    set(CPACK_RPM_FILE_NAME "RPM-DEFAULT")
    set(CPACK_RPM_PACKAGE_LICENSE "${CPACK_G_HTOP_LICENSE}")
    set(CPACK_RPM_PACKAGE_VENDOR "Donald E. Hunt")
    # CPack inserts this native RPM header into its generated spec.
    set(CPACK_RPM_SPEC_MORE_DEFINE "Packager: ${CPACK_PACKAGE_CONTACT}")
    set(CPACK_RPM_PACKAGE_GROUP "Applications/System")
    set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
    set(CPACK_RPM_PACKAGE_REQUIRES "gtkmm30, systemd, iproute, coreutils, hicolor-icon-theme")
    set(CPACK_RPM_PACKAGE_SUGGESTS "pciutils")
endif()

include(CPack)
