# Build metadata only: identify the actual configure/package host.
function(g_htop_host_family out_id out_family)
  set(host_id "unknown")
  set(host_like "")
  if(EXISTS "/etc/os-release")
    file(STRINGS "/etc/os-release" release_lines REGEX "^(ID|ID_LIKE)=")
    foreach(line IN LISTS release_lines)
      if(line MATCHES "^ID=(.*)$")
        set(host_id "${CMAKE_MATCH_1}")
      elseif(line MATCHES "^ID_LIKE=(.*)$")
        set(host_like "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  string(REPLACE "\"" "" host_id "${host_id}")
  string(REPLACE "\"" "" host_like "${host_like}")
  set(tokens " ${host_id} ${host_like} ")
  set(family "unsupported")
  if(tokens MATCHES " (debian|ubuntu|linuxmint) ")
    set(family "DEB")
  elseif(tokens MATCHES " (fedora|rhel|centos|rocky|almalinux) ")
    set(family "RPM")
  endif()
  set(${out_id} "${host_id}" PARENT_SCOPE)
  set(${out_family} "${family}" PARENT_SCOPE)
endfunction()
